From 3103db2e0629b408d52622b17129f2939f0600a2 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 18 Sep 2026 13:46:40 -0700
Subject: [PATCH] Replace deferred-recording clip tradeoff with a pre-roll
 buffer
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The previous fix for Whisper hallucination (a long, mostly-silent
prefix in the audio sent to Whisper) deferred recorder.start() until
speech was confirmed, at the cost of clipping ~250ms off the start of
every utterance. That tradeoff was explicitly rejected in favor of a
pre-roll buffer.

What changed:
- MediaRecorder now runs continuously for the whole listening period,
  chunked every 100ms via the timeslice argument to start().
- While not yet "speaking" (per the VAD state machine), each chunk
  goes into a bounded rolling pre-roll buffer (last 3 chunks, ~300ms)
  instead of the real transcript chunks.
- The moment speech is confirmed, the buffered pre-roll chunks are
  spliced onto the front of the real chunk array, then the buffer is
  cleared and new chunks go straight to the transcript from then on.

Net effect: no long silent prefix ever reaches Whisper (bounded to
~300ms max, regardless of how long the user was silent beforehand),
and the first word of the utterance is no longer clipped.

What was deliberately NOT changed:
- minSpeechDurationMs / minResumeDurationMs (the dual-threshold
  mid-sentence-cutoff fix) — untouched.
- NO_SPEECH_TIMEOUT_MS / MAX_NO_SPEECH_RETRIES (the 40s+ pause
  tolerance) — untouched.
- Mic constraints (plain `audio: true`), AudioContext lifecycle
  (fresh per turn), silence threshold, TTS audio quality, and the
  250ms post-playback transition delay — all untouched.
- finishTurn()/teardown() logic — verified still correct: recorder.stop()
  still flushes one final ondataavailable chunk (routed to `chunks`
  since `speaking` is true by then) before onstop fires.

No other files touched.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_018LxRUKiSrvtQUvbtNDFeFJ
---
 src/voice.ts | 70 +++++++++++++++++++++++++++++++++-------------------
 1 file changed, 44 insertions(+), 26 deletions(-)

diff --git a/src/voice.ts b/src/voice.ts
index 1bcbe1e..eeeb1cc 100644
--- a/src/voice.ts
+++ b/src/voice.ts
@@ -197,6 +197,17 @@ class VoiceActivityDetector {
   private sourceNode: MediaStreamAudioSourceNode | null = null;
   private recorder: MediaRecorder | null = null;
   private chunks: Blob[] = [];
+  // Rolling buffer of small chunks recorded WHILE NOT YET speaking. The
+  // recorder now runs continuously (see start()) instead of starting only
+  // once speech is confirmed, so this holds the last ~300ms immediately
+  // before the confirmation threshold is crossed. When speech is
+  // confirmed, these are spliced onto the front of `chunks` so the first
+  // word isn't clipped -- without this, waiting for minSpeechDurationMs to
+  // confirm real speech (not a blip) before starting to record meant that
+  // exact confirmation window was never captured.
+  private preRollChunks: Blob[] = [];
+  private static readonly TIMESLICE_MS = 100;
+  private static readonly PRE_ROLL_CHUNK_COUNT = 3; // ~300ms at 100ms/chunk
   private speaking = false;
   private aboveThresholdSince: number | null = null;
   private speechStartedAt: number | null = null;
@@ -279,26 +290,37 @@ class VoiceActivityDetector {
     this.opts.onDebug(`Using MediaRecorder mimeType: "${mimeType || '(browser default)'}"`);
     this.recorder = new MediaRecorder(this.stream, mimeType ? { mimeType } : undefined);
     this.chunks = [];
+    this.preRollChunks = [];
+    // The recorder runs continuously from the start of listening, chunked
+    // every TIMESLICE_MS via the timeslice argument to start() below --
+    // this is what makes a pre-roll buffer possible at all. While not yet
+    // "speaking" (per the VAD state machine), each small chunk goes into a
+    // bounded rolling pre-roll buffer instead of the real transcript
+    // chunks; once speech is confirmed, monitor() splices the buffered
+    // pre-roll chunks onto the front of `chunks` so the moment of
+    // confirmation doesn't clip the first word. This replaces an earlier
+    // approach that deferred recorder.start() entirely until speech was
+    // confirmed -- that avoided sending Whisper long silent prefixes (a
+    // real, confirmed hallucination trigger), but at the cost of clipping
+    // roughly the first ~250ms of every utterance. Continuous recording +
+    // a bounded pre-roll gets both: no long silent prefix ever reaches
+    // Whisper (only ~300ms max), and the first word is still captured.
     this.recorder.ondataavailable = (e) => {
-      if (e.data.size > 0) this.chunks.push(e.data);
+      if (e.data.size === 0) return;
+      if (this.speaking) {
+        this.chunks.push(e.data);
+      } else {
+        this.preRollChunks.push(e.data);
+        if (this.preRollChunks.length > VoiceActivityDetector.PRE_ROLL_CHUNK_COUNT) {
+          this.preRollChunks.shift();
+        }
+      }
     };
     this.speaking = false;
     this.aboveThresholdSince = null;
     this.speechStartedAt = null;
     this.silenceStart = null;
-    // Deliberately NOT starting the recorder here. The analyser above is
-    // already watching the stream independently, which is all that's
-    // needed to detect when speech begins -- recorder.start() itself now
-    // waits for that moment (see the onSpeechStart trigger in monitor()).
-    // A real captured session showed a 34-second recording where only the
-    // last 9 seconds were actual speech; the ~25s of near-silent waiting
-    // beforehand rode along in the same audio blob sent to Whisper, which
-    // is a documented trigger for its repetitive-hallucination failure
-    // mode on long, mostly-silent clips -- exactly what produced "A
-    // reflective conversation about feelings, relationships, and
-    // experiences, relationships, and experiences..." Recording only from
-    // the moment speech is confirmed eliminates that silent prefix
-    // entirely, and as a bonus makes for a smaller, faster upload.
+    this.recorder.start(VoiceActivityDetector.TIMESLICE_MS);
     this.lastDebugAt = 0;
     this.monitor();
   }
@@ -332,18 +354,14 @@ class VoiceActivityDetector {
       if (!this.speaking && now - this.aboveThresholdSince > this.opts.minSpeechDurationMs) {
         this.speaking = true;
         this.speechStartedAt = this.aboveThresholdSince;
-        this.opts.onDebug('Speech detected — recording turn');
-        // Recording begins now, not from when listening started -- see
-        // the constructor-time note above for why. One accepted tradeoff:
-        // since confirming real speech requires minSpeechDurationMs of
-        // sustained elevation first, the recorder starting only now means
-        // the very first ~250ms of the actual utterance (before it was
-        // confirmed as speech, not a blip) never gets captured. In
-        // practice this is a minor, likely-imperceptible clip at the very
-        // onset of the first word, not a mid-sentence loss -- and it's a
-        // clearly better trade than including up to tens of seconds of
-        // silence that actively causes Whisper to hallucinate.
-        this.recorder?.start();
+        this.opts.onDebug(`Speech detected — recording turn (with ${this.preRollChunks.length} pre-roll chunk(s))`);
+        // Splice in the buffered pre-roll audio so the moment right before
+        // confirmation -- the actual onset of the first word -- is part of
+        // the recording, not lost. The recorder itself has been running
+        // continuously since start() (see the note there); this only
+        // changes which bucket new chunks land in going forward.
+        this.chunks.push(...this.preRollChunks);
+        this.preRollChunks = [];
         this.opts.onSpeechStart();
       }
       // Evidence from a real captured session: legitimate resumed speech
