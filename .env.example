# Server-side only — never exposed to the client. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
PORT=8787

# Required by api/transcribe.ts (voice feature) for Groq's Whisper endpoint.
# Get a key at https://console.groq.com/keys. Separate from GEMINI_API_KEY —
# transcription doesn't go through Gemini.
GROQ_API_KEY=

# Which model performs memory extraction (server/services/memoryExtraction).
# Defaults to 'gemini' if unset. Independent of VITE_AI_PROVIDER below —
# lets you use Gemini for chat and a different model for extraction later.
MEMORY_EXTRACTION_PROVIDER=gemini

# Client-side toggle — safe to expose, it's not a secret, just a switch.
# 'mock' (default): no server, no API key, canned but realistic responses.
# 'gemini': calls the local server route above, which calls Gemini.
VITE_AI_PROVIDER=mock
